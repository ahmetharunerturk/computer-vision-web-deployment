# Environment configuration for this CV test & deploy boilerplate.
# Copy this file to ".env" and fill in real values. Set AUTH_USER/AUTH_PASS,
# or explicitly enable the demo account for local testing;
# process environment variables always take precedence over .env entries.
# Full walkthrough: USAGE.md.

# ---------- Web server ----------
HOST=0.0.0.0
PORT=8000

# ---------- Model ----------
# YOLO weights. Keep the same path/filename: replacing the file is enough,
# the app reloads the model automatically when it changes.
MODEL_PATH=./models/best.pt

# Confidence threshold used for detections (float between 0 and 1).
CONFIDENCE=0.60

# Folder scanned for selectable model weights (*.pt); empty = the folder of
# MODEL_PATH. Extra weights dropped there become selectable in the web UI
# (server-side files only - weights can not be uploaded through the app).
MODELS_DIR=

# ---------- Request logging (PostgreSQL) ----------
# Master switch for the request logger (true/false).
LOG_ENABLED=false
# PostgreSQL connection URI (libpq/psycopg format).
DATABASE_URL=
# Dedicated PostgreSQL schema created automatically for the logs.
LOG_SCHEMA=cv_detection

# ---------- Authentication (login gate) ----------
# Configured web login. These values are compared in memory and never written
# to the database. admin/pass only works when DEMO_LOGIN_ENABLED=true,
# even if that pair is written into AUTH_USER/AUTH_PASS.
# Leave the demo switch false on a public deployment.
AUTH_USER=
AUTH_PASS=
DEMO_LOGIN_ENABLED=false

# ---------- Project identity (UI texts) ----------
# Brand name shown in titles, the header, the login page and the API docs.
APP_NAME=Object Detection
# Short subtitle next to the brand name.
APP_TAGLINE=YOLO Inference
# Unit words used for detection counts ("1 object" / "3 objects").
UNIT_SINGULAR=object
UNIT_PLURAL=objects
# Optional whole-sentence overrides (blank = composed default sentences).
# PAGE_SUBTITLE=Upload an image to detect objects using the trained YOLO model.
# LOGIN_SUBTITLE=Sign in to use the detection tools.
PAGE_SUBTITLE=
LOGIN_SUBTITLE=

# ---------- Display names for model classes ----------
# Comma separated "raw_class=Displayed Name" pairs. The raw class name keeps
# flowing to JSON/logs; the UI (badges, table, box labels) shows the alias.
# LABEL_ALIASES=bird=Bird,cat=Cat
LABEL_ALIASES=

# ---------- Limits & serving policy ----------
# Upload size limit in megabytes (UI hint + server-side rejection).
UPLOAD_MAX_MB=10
# Maximum decoded width * height, to bound memory use.
MAX_IMAGE_PIXELS=25000000
# Weight file names the app refuses to serve (comma separated, case-insensitive).
BLOCKED_WEIGHTS=
